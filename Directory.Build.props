<Project>

  <!--
    Shared by every project in this repository. The folders that came from
    separate repositories keep their own Directory.Build.props, and each of
    those imports this file first.
  -->
  <PropertyGroup>
    <FiftyOneRoot>$(MSBuildThisFileDirectory)</FiftyOneRoot>
  </PropertyGroup>

  <!--
    A developer's own settings, not committed. The usual content is one line
    that switches to project references, see below.
  -->
  <Import Project="$(FiftyOneRoot)Directory.Build.local.props" Condition="Exists('$(FiftyOneRoot)Directory.Build.local.props')" />

  <!--
    How a project reaches a FiftyOne package that another folder of this
    repository builds. The project declares the dependency once, as

      <FiftyOneReference Include="FiftyOne.Pipeline.Engines"
                         ProjectPath="..\..\pipeline\Engines\FiftyOne.Pipeline.Engines.csproj"
                         Version="$(FiftyOnePipelineEnginesVersion)" />

    and Directory.Build.targets turns it into one of:

      Package  a PackageReference to the published package, the default, so
               a checkout builds the way a consumer's project does;
      Project  a ProjectReference to the project next to it, for a change
               that crosses packages, which is what CI builds and tests.

    Choose with any of these, the first that is set wins:

      dotnet build -p:FiftyOneReferences=Project
      a Directory.Build.local.props file next to this one holding
        <Project><PropertyGroup><FiftyOneReferences>Project</FiftyOneReferences></PropertyGroup></Project>
      the FiftyOneReferences environment variable
  -->
  <PropertyGroup>
    <FiftyOneReferences Condition="'$(FiftyOneReferences)' == ''">Package</FiftyOneReferences>
  </PropertyGroup>

  <!--
    A solution build drops its Configuration and Platform when it reaches a
    project outside the solution, which in Project mode is every reference
    into another folder. The on-premise engines then build their native
    library for the machine rather than the platform asked for, so an x86
    build of the examples loaded an x64 library. Keeping the parent's values
    builds the referenced projects the same way as the solution's own.
  -->
  <PropertyGroup>
    <ShouldUnsetParentConfigurationAndPlatform>false</ShouldUnsetParentConfigurationAndPlatform>
  </PropertyGroup>

  <!--
    The .NET 10 SDK prunes package references that the framework already
    provides, for every target framework of a project that targets net10.0.
    On net8.0 that would drop System.Text.Json 8.0.6 from the
    FiftyOne.Pipeline.Engines package, so the net8.0 builds restore without
    pruning and their dependencies stay as they were.
  -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <RestoreEnablePackagePruning>false</RestoreEnablePackagePruning>
  </PropertyGroup>

  <!--
    Examples, tests, tools and performance tests are never packed, as the
    specification says. A project under one of those folders can still set
    IsPackable itself.
  -->
  <PropertyGroup>
    <_FiftyOnePackPath>$([System.String]::Copy('$(MSBuildProjectDirectory)').Replace('\', '/'))/</_FiftyOnePackPath>
    <IsPackable Condition="$(_FiftyOnePackPath.Contains('/Tests/')) or $(_FiftyOnePackPath.Contains('/Examples/')) or $(_FiftyOnePackPath.Contains('/examples/')) or $(_FiftyOnePackPath.Contains('/performance-tests/')) or $(_FiftyOnePackPath.Contains('/Tools/')) or $(MSBuildProjectName.EndsWith('.Test')) or $(MSBuildProjectName.EndsWith('.Tests'))">false</IsPackable>
  </PropertyGroup>

  <!--
    The published version of each package, which Package mode, the
    examples and a local build use. A publish records the versions it
    released here, and the nightly package update changes them too.
  -->
  <PropertyGroup>
    <FiftyOneCommonVersion>5.1.10</FiftyOneCommonVersion>
    <FiftyOneCachingVersion>4.5.4</FiftyOneCachingVersion>
    <FiftyOneDidVersion>4.5.130</FiftyOneDidVersion>
    <FiftyOnePipelineCoreVersion>4.5.130</FiftyOnePipelineCoreVersion>
    <FiftyOneCommonTestHelpersVersion>5.1.10</FiftyOneCommonTestHelpersVersion>
    <FiftyOnePipelineEnginesVersion>4.5.130</FiftyOnePipelineEnginesVersion>
    <FiftyOnePipelineAgentSignatureVersion>4.5.130</FiftyOnePipelineAgentSignatureVersion>
    <FiftyOnePipelineCloudRequestEngineVersion>4.5.130</FiftyOnePipelineCloudRequestEngineVersion>
    <FiftyOnePipelineDerivedPropertyVersion>4.5.130</FiftyOnePipelineDerivedPropertyVersion>
    <FiftyOnePipelineEnginesFiftyOneVersion>4.5.130</FiftyOnePipelineEnginesFiftyOneVersion>
    <FiftyOnePipelineEnginesTestHelpersVersion>4.5.130</FiftyOnePipelineEnginesTestHelpersVersion>
    <FiftyOnePipelineExamplesSharedVersion>4.5.130</FiftyOnePipelineExamplesSharedVersion>
    <FiftyOnePipelineTranslationVersion>4.5.130</FiftyOnePipelineTranslationVersion>
    <FiftyOneDidCoreVersion>4.5.130</FiftyOneDidCoreVersion>
    <FiftyOnePipelineJsonBuilderVersion>4.5.130</FiftyOnePipelineJsonBuilderVersion>
    <FiftyOneDeviceDetectionSharedVersion>4.5.181</FiftyOneDeviceDetectionSharedVersion>
    <FiftyOneIpIntelligenceSharedVersion>4.5.156</FiftyOneIpIntelligenceSharedVersion>
    <FiftyOneGeolocationCoreVersion>4.5.197</FiftyOneGeolocationCoreVersion>
    <FiftyOneDidCloudVersion>4.5.130</FiftyOneDidCloudVersion>
    <FiftyOnePipelineJavaScriptBuilderVersion>4.5.130</FiftyOnePipelineJavaScriptBuilderVersion>
    <FiftyOneDeviceDetectionCloudVersion>4.5.181</FiftyOneDeviceDetectionCloudVersion>
    <FiftyOneDeviceDetectionHashEngineOnPremiseVersion>4.5.181</FiftyOneDeviceDetectionHashEngineOnPremiseVersion>
    <FiftyOneIpIntelligenceEngineOnPremiseVersion>4.5.156</FiftyOneIpIntelligenceEngineOnPremiseVersion>
    <FiftyOneIpIntelligenceTranslationVersion>4.5.156</FiftyOneIpIntelligenceTranslationVersion>
    <FiftyOneGeolocationCloudVersion>4.5.197</FiftyOneGeolocationCloudVersion>
    <FiftyOnePipelineWebSharedVersion>4.5.130</FiftyOnePipelineWebSharedVersion>
    <FiftyOneDeviceDetectionVersion>4.5.181</FiftyOneDeviceDetectionVersion>
    <FiftyOneDeviceDetectionPropertyKeyedVersion>4.5.181</FiftyOneDeviceDetectionPropertyKeyedVersion>
    <FiftyOneIpIntelligenceCloudVersion>4.5.156</FiftyOneIpIntelligenceCloudVersion>
    <FiftyOneGeolocationVersion>4.5.197</FiftyOneGeolocationVersion>
    <FiftyOnePipelineWebVersion>4.5.130</FiftyOnePipelineWebVersion>
    <FiftyOneDeviceDetectionRobotsTxtVersion>4.5.181</FiftyOneDeviceDetectionRobotsTxtVersion>
    <FiftyOneIpIntelligenceVersion>4.5.156</FiftyOneIpIntelligenceVersion>
    <FiftyOneDeviceDetectionRobotsTxtCloudVersion>4.5.181</FiftyOneDeviceDetectionRobotsTxtCloudVersion>
  </PropertyGroup>

  <!--
    The version each package's project builds at, by the project's
    name. It is set here, where a change releases no package, so how a
    version is set is never a change to the package itself.
  -->
  <PropertyGroup>
    <Version Condition="'$(Version)' == '' and '$(MSBuildProjectName)' == 'FiftyOne.Common'">$(FiftyOneCommonVersion)</Version>
    <Version Condition="'$(Version)' == '' and '$(MSBuildProjectName)' == 'FiftyOne.Caching'">$(FiftyOneCachingVersion)</Version>
    <Version Condition="'$(Version)' == '' and '$(MSBuildProjectName)' == 'FiftyOne.Did'">$(FiftyOneDidVersion)</Version>
    <Version Condition="'$(Version)' == '' and '$(MSBuildProjectName)' == 'FiftyOne.Pipeline.Core'">$(FiftyOnePipelineCoreVersion)</Version>
    <Version Condition="'$(Version)' == '' and '$(MSBuildProjectName)' == 'FiftyOne.Common.TestHelpers'">$(FiftyOneCommonTestHelpersVersion)</Version>
    <Version Condition="'$(Version)' == '' and '$(MSBuildProjectName)' == 'FiftyOne.Pipeline.Engines'">$(FiftyOnePipelineEnginesVersion)</Version>
    <Version Condition="'$(Version)' == '' and '$(MSBuildProjectName)' == 'FiftyOne.Pipeline.AgentSignature'">$(FiftyOnePipelineAgentSignatureVersion)</Version>
    <Version Condition="'$(Version)' == '' and '$(MSBuildProjectName)' == 'FiftyOne.Pipeline.CloudRequestEngine'">$(FiftyOnePipelineCloudRequestEngineVersion)</Version>
    <Version Condition="'$(Version)' == '' and '$(MSBuildProjectName)' == 'FiftyOne.Pipeline.DerivedProperty'">$(FiftyOnePipelineDerivedPropertyVersion)</Version>
    <Version Condition="'$(Version)' == '' and '$(MSBuildProjectName)' == 'FiftyOne.Pipeline.Engines.FiftyOne'">$(FiftyOnePipelineEnginesFiftyOneVersion)</Version>
    <Version Condition="'$(Version)' == '' and '$(MSBuildProjectName)' == 'FiftyOne.Pipeline.Engines.TestHelpers'">$(FiftyOnePipelineEnginesTestHelpersVersion)</Version>
    <Version Condition="'$(Version)' == '' and '$(MSBuildProjectName)' == 'FiftyOne.Pipeline.Examples.Shared'">$(FiftyOnePipelineExamplesSharedVersion)</Version>
    <Version Condition="'$(Version)' == '' and '$(MSBuildProjectName)' == 'FiftyOne.Pipeline.Translation'">$(FiftyOnePipelineTranslationVersion)</Version>
    <Version Condition="'$(Version)' == '' and '$(MSBuildProjectName)' == 'FiftyOne.Did.Core'">$(FiftyOneDidCoreVersion)</Version>
    <Version Condition="'$(Version)' == '' and '$(MSBuildProjectName)' == 'FiftyOne.Pipeline.JsonBuilder'">$(FiftyOnePipelineJsonBuilderVersion)</Version>
    <Version Condition="'$(Version)' == '' and '$(MSBuildProjectName)' == 'FiftyOne.DeviceDetection.Shared'">$(FiftyOneDeviceDetectionSharedVersion)</Version>
    <Version Condition="'$(Version)' == '' and '$(MSBuildProjectName)' == 'FiftyOne.IpIntelligence.Shared'">$(FiftyOneIpIntelligenceSharedVersion)</Version>
    <Version Condition="'$(Version)' == '' and '$(MSBuildProjectName)' == 'FiftyOne.GeoLocation.Core'">$(FiftyOneGeolocationCoreVersion)</Version>
    <Version Condition="'$(Version)' == '' and '$(MSBuildProjectName)' == 'FiftyOne.Did.Cloud'">$(FiftyOneDidCloudVersion)</Version>
    <Version Condition="'$(Version)' == '' and '$(MSBuildProjectName)' == 'FiftyOne.Pipeline.JavaScriptBuilder'">$(FiftyOnePipelineJavaScriptBuilderVersion)</Version>
    <Version Condition="'$(Version)' == '' and '$(MSBuildProjectName)' == 'FiftyOne.DeviceDetection.Cloud'">$(FiftyOneDeviceDetectionCloudVersion)</Version>
    <Version Condition="'$(Version)' == '' and '$(MSBuildProjectName)' == 'FiftyOne.DeviceDetection.Hash.Engine.OnPremise'">$(FiftyOneDeviceDetectionHashEngineOnPremiseVersion)</Version>
    <Version Condition="'$(Version)' == '' and '$(MSBuildProjectName)' == 'FiftyOne.IpIntelligence.Engine.OnPremise'">$(FiftyOneIpIntelligenceEngineOnPremiseVersion)</Version>
    <Version Condition="'$(Version)' == '' and '$(MSBuildProjectName)' == 'FiftyOne.IpIntelligence.Translation'">$(FiftyOneIpIntelligenceTranslationVersion)</Version>
    <Version Condition="'$(Version)' == '' and '$(MSBuildProjectName)' == 'FiftyOne.GeoLocation.Cloud'">$(FiftyOneGeolocationCloudVersion)</Version>
    <Version Condition="'$(Version)' == '' and '$(MSBuildProjectName)' == 'FiftyOne.Pipeline.Web.Shared'">$(FiftyOnePipelineWebSharedVersion)</Version>
    <Version Condition="'$(Version)' == '' and '$(MSBuildProjectName)' == 'FiftyOne.DeviceDetection'">$(FiftyOneDeviceDetectionVersion)</Version>
    <Version Condition="'$(Version)' == '' and '$(MSBuildProjectName)' == 'FiftyOne.DeviceDetection.PropertyKeyed'">$(FiftyOneDeviceDetectionPropertyKeyedVersion)</Version>
    <Version Condition="'$(Version)' == '' and '$(MSBuildProjectName)' == 'FiftyOne.IpIntelligence.Cloud'">$(FiftyOneIpIntelligenceCloudVersion)</Version>
    <Version Condition="'$(Version)' == '' and '$(MSBuildProjectName)' == 'FiftyOne.GeoLocation'">$(FiftyOneGeolocationVersion)</Version>
    <Version Condition="'$(Version)' == '' and '$(MSBuildProjectName)' == 'FiftyOne.Pipeline.Web'">$(FiftyOnePipelineWebVersion)</Version>
    <Version Condition="'$(Version)' == '' and '$(MSBuildProjectName)' == 'FiftyOne.Pipeline.Web.Framework'">$(FiftyOnePipelineWebVersion)</Version>
    <Version Condition="'$(Version)' == '' and '$(MSBuildProjectName)' == 'FiftyOne.DeviceDetection.RobotsTxt'">$(FiftyOneDeviceDetectionRobotsTxtVersion)</Version>
    <Version Condition="'$(Version)' == '' and '$(MSBuildProjectName)' == 'FiftyOne.IpIntelligence'">$(FiftyOneIpIntelligenceVersion)</Version>
    <Version Condition="'$(Version)' == '' and '$(MSBuildProjectName)' == 'FiftyOne.DeviceDetection.RobotsTxt.Cloud'">$(FiftyOneDeviceDetectionRobotsTxtCloudVersion)</Version>
  </PropertyGroup>
</Project>
