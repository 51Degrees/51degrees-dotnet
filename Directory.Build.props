<Project>

  <!--
    Shared by every project in this repository. The folders that came from
    separate repositories keep their own Directory.Build.props, and each of
    those imports this file first.
  -->
  <PropertyGroup>
    <FiftyOneRoot>$(MSBuildThisFileDirectory)</FiftyOneRoot>
  </PropertyGroup>

  <!--
    A developer's own settings, not committed. The usual content is one line
    that switches to project references, see below.
  -->
  <Import Project="$(FiftyOneRoot)Directory.Build.local.props" Condition="Exists('$(FiftyOneRoot)Directory.Build.local.props')" />

  <!--
    How a project reaches a FiftyOne package that another folder of this
    repository builds. The project declares the dependency once, as

      <FiftyOneReference Include="FiftyOne.Pipeline.Engines"
                         ProjectPath="..\..\pipeline\Engines\FiftyOne.Pipeline.Engines.csproj"
                         Version="$(FiftyOnePipelineVersion)" />

    and Directory.Build.targets turns it into one of:

      Package  a PackageReference to the published package, the default, so
               a checkout builds the way a consumer's project does;
      Project  a ProjectReference to the project next to it, for a change
               that crosses packages, which is what CI builds and tests.

    Choose with any of these, the first that is set wins:

      dotnet build -p:FiftyOneReferences=Project
      a Directory.Build.local.props file next to this one holding
        <Project><PropertyGroup><FiftyOneReferences>Project</FiftyOneReferences></PropertyGroup></Project>
      the FiftyOneReferences environment variable
  -->
  <PropertyGroup>
    <FiftyOneReferences Condition="'$(FiftyOneReferences)' == ''">Package</FiftyOneReferences>
  </PropertyGroup>

  <!--
    A solution build drops its Configuration and Platform when it reaches a
    project outside the solution, which in Project mode is every reference
    into another folder. The on-premise engines then build their native
    library for the machine rather than the platform asked for, so an x86
    build of the examples loaded an x64 library. Keeping the parent's values
    builds the referenced projects the same way as the solution's own.
  -->
  <PropertyGroup>
    <ShouldUnsetParentConfigurationAndPlatform>false</ShouldUnsetParentConfigurationAndPlatform>
  </PropertyGroup>

  <!--
    The .NET 10 SDK prunes package references that the framework already
    provides, for every target framework of a project that targets net10.0.
    On net8.0 that would drop System.Text.Json 8.0.6 from the
    FiftyOne.Pipeline.Engines package, so the net8.0 builds restore without
    pruning and their dependencies stay as they were.
  -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <RestoreEnablePackagePruning>false</RestoreEnablePackagePruning>
  </PropertyGroup>

  <!--
    Examples, tests, tools and performance tests are never packed, as the
    specification says. A project under one of those folders can still set
    IsPackable itself.
  -->
  <PropertyGroup>
    <_FiftyOnePackPath>$([System.String]::Copy('$(MSBuildProjectDirectory)').Replace('\', '/'))/</_FiftyOnePackPath>
    <IsPackable Condition="$(_FiftyOnePackPath.Contains('/Tests/')) or $(_FiftyOnePackPath.Contains('/Examples/')) or $(_FiftyOnePackPath.Contains('/examples/')) or $(_FiftyOnePackPath.Contains('/performance-tests/')) or $(_FiftyOnePackPath.Contains('/Tools/')) or $(MSBuildProjectName.EndsWith('.Test')) or $(MSBuildProjectName.EndsWith('.Tests'))">false</IsPackable>
  </PropertyGroup>

  <!--
    The published version of each package family that the Package mode
    restores. Until the first release from this repository these are the
    versions the separate repositories last published. The nightly package
    update changes them here.
  -->
  <PropertyGroup>
    <FiftyOneCommonVersion>5.1.10</FiftyOneCommonVersion>
    <FiftyOneCachingVersion>4.5.4</FiftyOneCachingVersion>
    <FiftyOnePipelineVersion>4.5.130</FiftyOnePipelineVersion>
    <FiftyOneDeviceDetectionVersion>4.5.181</FiftyOneDeviceDetectionVersion>
    <FiftyOneIpIntelligenceVersion>4.5.156</FiftyOneIpIntelligenceVersion>
    <FiftyOneGeoLocationVersion>4.5.197</FiftyOneGeoLocationVersion>
  </PropertyGroup>

</Project>
