<Project>
  <!-- The settings shared by the whole repository come first. -->
  <Import Project="$(MSBuildThisFileDirectory)..\Directory.Build.props" />
  <PropertyGroup>
    <!-- The family version from the root file, unless the build passes one. -->
    <Version Condition="'$(Version)' == ''">$(FiftyOneCachingVersion)</Version>
    <AssemblyVersion>4.5.0.0</AssemblyVersion>

    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile Condition="'$(BuiltOnCI)' != 'true'">$(FiftyOneRoot)51Degrees.publickey</AssemblyOriginatorKeyFile>
    <AssemblyOriginatorKeyFile Condition="'$(BuiltOnCI)' == 'true'">$(FiftyOneRoot)51Degrees.snk</AssemblyOriginatorKeyFile>
    <PublicSign Condition="'$(BuiltOnCI)' != 'true'">true</PublicSign>
    <PublicSign Condition="'$(BuiltOnCI)' == 'true'">false</PublicSign>
  </PropertyGroup>
</Project>
