+        /// <summary>
+        /// The timeout to use for requests to the cloud service.
+        /// This budget covers the whole request, including the DNS lookup and
+        /// TLS handshake, so the first request made by a process can need
+        /// noticeably longer than later ones.
+        /// </summary>
+        /// <param name="timeoutSeconds">
+        /// The timeout to use, in seconds. A value of zero or less means the
+        /// request will never time out.
+        /// </param>
+        /// <returns>
+        /// This builder
+        /// </returns>
+        [DefaultValue(Constants.CLOUD_REQUEST_TIMEOUT_DEFAULT_SECONDS)]
+        public TBuilder SetCloudRequestTimeOutSeconds(int timeoutSeconds)
+        {
+            CloudRequestTimeoutSeconds = timeoutSeconds;
+            return this as TBuilder;
+        }
