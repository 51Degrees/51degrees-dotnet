+using FiftyOne.Pipeline.CloudRequestEngine.FlowElements;
+using Microsoft.Extensions.Logging;
+using Microsoft.VisualStudio.TestTools.UnitTesting;
+using Moq;
+using Moq.Protected;
+using System;
+using System.Net;
+using System.Net.Http;
+using System.Threading;
+using System.Threading.Tasks;
+
+namespace FiftyOne.Pipeline.CloudRequestEngine.Tests
+{
+    /// <summary>
+    /// Tests for the settings that <see cref="CloudPipelineBuilderBase{T}"/>
+    /// passes on to the cloud request engine it builds.
+    /// </summary>
+    [TestClass]
+    public class CloudPipelineBuilderBaseTests
+    {
+        /// <summary>
+        /// Minimal concrete builder. The base class is abstract and every
+        /// real subclass lives in a downstream repository, so the tests need
+        /// their own to exercise it.
+        /// </summary>
+        private class TestCloudPipelineBuilder
+            : CloudPipelineBuilderBase<TestCloudPipelineBuilder>
+        {
+            public TestCloudPipelineBuilder(
+                ILoggerFactory loggerFactory,
+                HttpClient httpClient)
+                : base(loggerFactory, httpClient)
+            {
+            }
+        }
+
+        private HttpClient _httpClient;
+
+        [TestInitialize]
+        public void Init()
+        {
+            var handlerMock = new Mock<HttpMessageHandler>(MockBehavior.Strict);
+            // The engine calls both discovery endpoints as it warms up. The
+            // content does not matter here, only that the calls complete.
+            handlerMock
+                .Protected()
+                .Setup<Task<HttpResponseMessage>>(
+                    "SendAsync",
+                    ItExpr.IsAny<HttpRequestMessage>(),
+                    ItExpr.IsAny<CancellationToken>())
+                .ReturnsAsync(() => new HttpResponseMessage()
+                {
+                    StatusCode = HttpStatusCode.OK,
+                    Content = new StringContent("{}"),
+                });
+
+            _httpClient = new HttpClient(handlerMock.Object);
+            Environment.SetEnvironmentVariable(Constants.FOD_CLOUD_API_URL, "");
+        }
+
+        /// <summary>
+        /// A pipeline built without touching the timeout must keep the
+        /// documented default, so adding the setter changes nothing for
+        /// callers who do not use it.
+        /// </summary>
+        [TestMethod]
+        public void CloudRequestTimeOut_Default_IsUnchanged()
+        {
+            using (new TestCloudPipelineBuilder(new LoggerFactory(), _httpClient)
+                .SetResourceKey("abcdefgh")
+                .Build())
+            {
+                Assert.AreEqual(
+                    TimeSpan.FromSeconds(
+                        Constants.CLOUD_REQUEST_TIMEOUT_DEFAULT_SECONDS),
+                    _httpClient.Timeout,
+                    "A pipeline built through the fluent builder should use " +
+                    "the default cloud request timeout.");
+            }
+        }
+
+        /// <summary>
+        /// The point of the change: a timeout set on the pipeline builder
+        /// must reach the cloud request engine it builds.
+        /// </summary>
+        [TestMethod]
+        public void CloudRequestTimeOut_IsPassedToTheEngine()
+        {
+            using (new TestCloudPipelineBuilder(new LoggerFactory(), _httpClient)
+                .SetResourceKey("abcdefgh")
+                .SetCloudRequestTimeOutSeconds(30)
+                .Build())
+            {
+                Assert.AreEqual(
+                    TimeSpan.FromSeconds(30),
+                    _httpClient.Timeout,
+                    "The timeout set on the pipeline builder should be used " +
+                    "for requests to the cloud service.");
+            }
+        }
+
+        /// <summary>
+        /// Zero or less means 'never time out' rather than 'time out
+        /// immediately', which is what the setter documents.
+        /// </summary>
+        [TestMethod]
+        public void CloudRequestTimeOut_ZeroOrLess_MeansInfinite()
+        {
+            using (new TestCloudPipelineBuilder(new LoggerFactory(), _httpClient)
+                .SetResourceKey("abcdefgh")
+                .SetCloudRequestTimeOutSeconds(0)
+                .Build())
+            {
+                Assert.AreEqual(
+                    Timeout.InfiniteTimeSpan,
+                    _httpClient.Timeout,
+                    "A timeout of zero should disable the timeout entirely.");
+            }
+        }
+
+        [TestCleanup]
+        public void Cleanup()
+        {
+            // The client is deliberately not disposed: the strict mock has no
+            // setup for HttpMessageHandler.Dispose, and each test gets a fresh
+            // client from Init anyway.
+            Environment.SetEnvironmentVariable(Constants.FOD_CLOUD_API_URL, "");
+        }
+    }
+}
