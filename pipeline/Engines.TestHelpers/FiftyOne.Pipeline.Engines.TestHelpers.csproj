<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Platforms>AnyCPU</Platforms>	
	
	<!-- NuGet package properties -->
	<PackageId>FiftyOne.Pipeline.Engines.TestHelpers</PackageId>
	<Title>Helper classes to assist with writing unit tests for engines for the 51Degrees Pipeline API</Title>
	<Authors>51Degrees Engineering</Authors>
    <PackageLicenseExpression>EUPL-1.2</PackageLicenseExpression>
	<PackageIconUrl>https://51degrees.com/portals/0/Logos/Square%20Logo.png?width=64</PackageIconUrl>
	<Copyright>51Degrees Mobile Experts Limited</Copyright>
	<PackageTags>51degrees,pipeline,data service</PackageTags>
	<RepositoryUrl>https://github.com/51Degrees/51degrees-dotnet</RepositoryUrl>
	<PackageProjectUrl>https://51degrees.com/build-your-own?utm_source=nuget&amp;utm_medium=package&amp;utm_campaign=51degrees-dotnet&amp;utm_content=fiftyone.pipeline.engines.testhelpers&amp;utm_term=packageprojecturl</PackageProjectUrl>
	<Description>The 51Degrees Pipeline API provides a fast, modern architecture for consuming real-time digital data services. The package contains helper classes to make writing unit tests easier when developing a custom engine using FiftyOne.Pipeline.Engines.</Description>
	<PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Engines\FiftyOne.Pipeline.Engines.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Moq" Version="4.20.72" />
  </ItemGroup>

</Project>
