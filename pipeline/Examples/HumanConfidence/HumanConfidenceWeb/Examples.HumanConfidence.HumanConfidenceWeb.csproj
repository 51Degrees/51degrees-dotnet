<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <Platforms>AnyCPU</Platforms>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Both are read from the output directory at start-up, so both
         have to be copied there. -->
    <None Include="page.html" CopyToOutputDirectory="PreserveNewest" />
    <None Include="examples-main.min.css"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The web integration and the cloud engines that ask for Human
         Confidence and redeem it. -->
    <ProjectReference Include="..\..\..\Web\FiftyOne.Pipeline.Web.csproj" />
    <ProjectReference Include="..\..\..\CloudRequestEngine\FiftyOne.Pipeline.CloudRequestEngine.csproj" />
  </ItemGroup>

</Project>
