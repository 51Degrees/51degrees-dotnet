<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- .NET Framework, where only Windows runs it, is the runtime that
         loads the netstandard2.0 build in practice, and its RSA.Create()
         gives an RSA that differs from the one net8.0 gives. -->
    <TargetFrameworks Condition=" '$(OS)' == 'Windows_NT' ">net8.0;net462</TargetFrameworks>
    <TargetFrameworks Condition=" '$(OS)' != 'Windows_NT' ">net8.0</TargetFrameworks>

    <IsPackable>false</IsPackable>

    <Platforms>AnyCPU</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.9.3" />
    <PackageReference Include="MSTest.TestFramework" Version="3.9.3" />
  </ItemGroup>

  <ItemGroup Condition=" '$(TargetFramework)' == 'net462' ">
    <!-- The shared signing helpers read JSON with System.Text.Json and
         serve keys through HttpClient, which .NET Framework does not
         carry by default. -->
    <PackageReference Include="System.Text.Json" Version="8.0.6" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <!-- The netstandard2.0 build of the element is the one a .NET
         Framework consumer loads, and it reads JSON with Newtonsoft
         rather than System.Text.Json. Naming the target framework here
         makes this test project run that build, where every other test
         project runs the net8.0 build. -->
    <ProjectReference
        Include="..\..\AgentSignature\FiftyOne.Pipeline.AgentSignature.csproj"
        SetTargetFramework="TargetFramework=netstandard2.0" />
    <!-- Without this, the engines project arrives transitively and
         resolves to its net8.0 build, leaving the element's dependencies
         mixed. Naming it directly keeps the whole set of pipeline
         assemblies on the builds a .NET Framework consumer loads. -->
    <ProjectReference
        Include="..\..\Engines\FiftyOne.Pipeline.Engines.csproj"
        SetTargetFramework="TargetFramework=netstandard2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- These helpers belong to the main test project and compile
         against the element's public surface alone, so they are shared
         by link rather than copied. The main project's ElementHarness is
         not linked, because it reaches internal members that only the
         main test assembly is granted access to. -->
    <Compile
        Include="..\AgentSignatureTests\Helpers\FakeHttpHandler.cs"
        Link="Helpers\FakeHttpHandler.cs" />
    <Compile
        Include="..\AgentSignatureTests\Helpers\RequestSigner.cs"
        Link="Helpers\RequestSigner.cs" />
    <Compile
        Include="..\AgentSignatureTests\Helpers\Fixtures.cs"
        Link="Helpers\Fixtures.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The signing helper reads the RFC 9421 Ed25519 and RSA-PSS test
         keys from the main test project's fixture folder, so the files
         travel to the output by link rather than by copy. -->
    <None
        Include="..\AgentSignatureTests\Fixtures\ed25519.json"
        Link="Fixtures\ed25519.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None
        Include="..\AgentSignatureTests\Fixtures\rsapss.json"
        Link="Fixtures\rsapss.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
