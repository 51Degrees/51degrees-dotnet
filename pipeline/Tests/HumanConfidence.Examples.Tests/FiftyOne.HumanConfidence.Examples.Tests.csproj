<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <AssemblyName>FiftyOne.HumanConfidence.Examples.Tests</AssemblyName>
    <RootNamespace>FiftyOne.HumanConfidence.Examples.Tests</RootNamespace>
    <Platforms>AnyCPU</Platforms>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.2.3" />
    <PackageReference Include="MSTest.TestFramework" Version="4.2.3" />
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- The reference builds the example before the tests, which is where
         the without-key test finds its build. -->
    <ProjectReference Include="..\..\Examples\HumanConfidence\HumanConfidenceWeb\Examples.HumanConfidence.HumanConfidenceWeb.csproj" />
  </ItemGroup>

</Project>
