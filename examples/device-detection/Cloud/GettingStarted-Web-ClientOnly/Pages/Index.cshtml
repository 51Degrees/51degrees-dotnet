@page
@model FiftyOne.DeviceDetection.Examples.Cloud.GettingStartedWeb.ClientOnly.Pages.Model
@{
    ViewData["Title"] = "Client Only - Cloud Example";
    var resourceUrl = $"{Model.CloudEndPoint}/api/v4/{Model.ResourceKey}.js";
}

<div class="c-eg-page">
    <h2 class="c-eg-page__title">Client-side only example</h2>
    <p class="c-eg-page__lead">
        Detection runs entirely client-side. The 51Degrees JavaScript collects evidence in the browser
        and populates the results below once it completes, with no server-side rendering.
    </p>
    <div id="content"></div>

    <div class="c-eg-message">
      <p class="c-eg-message__text">Want to try on-premise? <a href="https://51degrees.com/contact-us?utm_source=code&amp;utm_medium=example&amp;utm_campaign=51degrees-dotnet&amp;utm_content=examples-cloud-gettingstarted-web-clientonly-pages-index.cshtml&amp;utm_term=try-on-premise">Contact us</a> to discuss requirements.</p>
      <a class="b-btn c-eg-message__cta" href="https://51degrees.com/contact-us?utm_source=code&amp;utm_medium=example&amp;utm_campaign=51degrees-dotnet&amp;utm_content=examples-cloud-gettingstarted-web-clientonly-pages-index.cshtml&amp;utm_term=try-on-premise">Contact us</a>
    </div>

    @* Kept outside #content, which the client-side results are appended to,
        so this section stays at the end of the page. *@
    <div class="c-eg-section" id="find-out-more">
        <hr />
        <h3 class="c-eg-page__heading">Find out more</h3>
        <ul>
            <li><a href="https://51degrees.com/documentation/_device_detection__overview.html?utm_source=code&amp;utm_medium=example&amp;utm_campaign=51degrees-dotnet&amp;utm_content=examples-cloud-gettingstarted-web-clientonly-pages-index.cshtml&amp;utm_term=find-out-more">How device detection works</a></li>
            <li><a href="https://51degrees.com/pricing?utm_source=code&amp;utm_medium=example&amp;utm_campaign=51degrees-dotnet&amp;utm_content=examples-cloud-gettingstarted-web-clientonly-pages-index.cshtml&amp;utm_term=find-out-more">Plans and prices</a></li>
            <li><a href="https://51degrees.com/contact-us?utm_source=code&amp;utm_medium=example&amp;utm_campaign=51degrees-dotnet&amp;utm_content=examples-cloud-gettingstarted-web-clientonly-pages-index.cshtml&amp;utm_term=find-out-more">Talk to 51Degrees about using it</a></li>
        </ul>
        <p class="c-eg-page__lead">The source code for this demo and what it uses.</p>
        <ul>
            <li><a href="https://github.com/51Degrees/51degrees-dotnet/tree/main/examples/device-detection">https://github.com/51Degrees/51degrees-dotnet/tree/main/examples/device-detection</a></li>
            <li><a href="https://github.com/51Degrees/51degrees-dotnet/tree/main/device-detection">https://github.com/51Degrees/51degrees-dotnet/tree/main/device-detection</a></li>
            <li><a href="https://github.com/51Degrees/51degrees-dotnet/tree/main/pipeline">https://github.com/51Degrees/51degrees-dotnet/tree/main/pipeline</a></li>
        </ul>
    </div>
</div>

@* The cloud resource script raises the 'complete' event with the detection
    results. The shared examples.js helper subscribes to it and appends the
    results table into #content. *@
<script async src="@resourceUrl" type="text/javascript"></script>
<script src="~/js/examples.min.js"></script>
<script>
    window.onload = function () {
        fodExamples.bindDeviceCallback({ targetId: "content" });
    };
</script>
