<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <!-- C# 10 for file-scoped namespaces, as netstandard2.0 defaults to 7.3. -->
    <LangVersion>10</LangVersion>
    <AssemblyName>FiftyOne.DeviceDetection.Examples</AssemblyName>
    <Platforms>AnyCPU;x86;x64</Platforms>
    <Configurations>Debug;Release</Configurations>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors></WarningsAsErrors>
  </PropertyGroup>
    
	<ItemGroup>
		<FiftyOneReference Include="FiftyOne.DeviceDetection" ProjectPath="..\..\..\device-detection\DeviceDetection\FiftyOne.DeviceDetection.csproj" Version="$(FiftyOneDeviceDetectionVersion)" />
		<PackageReference Include="YamlDotNet" Version="16.2.1" />
	</ItemGroup>
</Project>
