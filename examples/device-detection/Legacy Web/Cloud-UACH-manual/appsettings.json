{
  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  },
  "AllowedHosts": "*",
  // For a sample configuration file demonstrating all available options, see 
  // https://github.com/51Degrees/51degrees-dotnet/blob/main/examples/device-detection/sample-configuration.json
  "PipelineOptions": {
    "Elements": [
      {
        "BuilderName": "CloudRequestEngine",
        // A free resource key created at https://51degrees.com/configure/Wkqxf3Bs?utm_source=code&utm_medium=example&utm_campaign=51degrees-dotnet&utm_content=examples-legacy-web-cloud-uach-manual-appsettings.json&utm_term=elements
        // populates the free properties. A paid subscription key created at
        // https://51degrees.com/configure/hYzn3TV3?utm_source=code&utm_medium=example&utm_campaign=51degrees-dotnet&utm_content=examples-legacy-web-cloud-uach-manual-appsettings.json&utm_term=elements includes all the properties
        // used by this example.
        // The properties used in this example are:
        //   HardwareVendor, HardwareName, DeviceType
        //   PlatformVendor, PlatformName, PlatformVersion
        //   BrowserVendor, BrowserName, BrowserVersion
        //   SetHeaderBrowserAccept-CH, SetHeaderHardwareAccept-CH,
        //   SetHeaderPlatformAccept-CH
        "BuildParameters": {
          "ResourceKey": "!!ENTER_YOUR_RESOURCE_KEY_HERE!!"
        }
      },
      {
        "BuilderName": "DeviceDetectionCloudEngine"
      }
    ],
    "BuildParameters": {
      //Suppress and log exceptions thrown from within (Web)Pipeline.Process().
      //Set to `true` here so a device-detection failure degrades gracefully instead of
      //returning a 500 for every request. Use `false` while developing to surface mistakes loudly.
      "SuppressProcessExceptions": true
    }
  }
}
