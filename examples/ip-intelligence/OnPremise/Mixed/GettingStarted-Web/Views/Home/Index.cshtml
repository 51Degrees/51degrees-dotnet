@model FiftyOne.IpIntelligence.Examples.Mixed.OnPremise.GettingStartedWeb.Model.IndexModel
@{
    ViewData["Title"] = "Device Detection + IP Intelligence Example";
}

<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="stylesheet" href="~/css/examples-main.min.css" />

<div class="c-eg-page">
    <h2 class="c-eg-page__title">Combined device detection and IP intelligence example</h2>
    <p class="c-eg-page__lead">
        This example demonstrates the use of the Pipeline API to perform both device detection and
        IP intelligence lookups within a single ASP.NET Core web project. It highlights device
        detection using User-Agent and Client Hints, IP-based geolocation and network information,
        and client-side evidence collection for enhanced detection.
    </p>

    <noscript>
        <div class="c-eg-alert">
            WARNING: JavaScript is disabled in your browser. This means that client-side evidence
            collection will not work and some device properties may not be accurately detected.
        </div>
    </noscript>

    <div id="content">
        <form method="get" asp-action="Index" class="c-eg-form">
            <div class="c-eg-form__row">
                <label class="b-label" for="client-ip">IP Address Lookup:</label>
                <input class="b-input" type="text" id="client-ip" name="client-ip" value="@Model.UserInputIp"
                       placeholder="e.g., 8.8.8.8">
                <button class="b-btn" type="submit">Look Up</button>
            </div>
        </form>

        <div class="c-eg-columns">
            <div>
                <h3 class="c-eg-page__heading">Device detection results</h3>
                @if (!string.IsNullOrEmpty(Model.DeviceMessage))
                {
                    <p class="c-eg-page__lead">@Model.DeviceMessage</p>
                }
                <table class="c-eg-table">
                    <thead class="c-eg-table__head">
                        <tr class="c-eg-table__row">
                            <th class="c-eg-table__cell">Property</th>
                            <th class="c-eg-table__cell">Value</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr class="c-eg-table__row c-eg-table__row--alt"><td class="c-eg-table__cell c-eg-table__cell--key">Hardware Vendor:</td><td class="c-eg-table__cell" id="HardwareVendor">@Model.HardwareVendor</td></tr>
                        <tr class="c-eg-table__row"><td class="c-eg-table__cell c-eg-table__cell--key">Hardware Name:</td><td class="c-eg-table__cell" id="HardwareName">@Model.HardwareName</td></tr>
                        <tr class="c-eg-table__row c-eg-table__row--alt"><td class="c-eg-table__cell c-eg-table__cell--key">Device Type:</td><td class="c-eg-table__cell" id="DeviceType">@Model.DeviceType</td></tr>
                        <tr class="c-eg-table__row"><td class="c-eg-table__cell c-eg-table__cell--key">Platform Vendor:</td><td class="c-eg-table__cell">@Model.PlatformVendor</td></tr>
                        <tr class="c-eg-table__row c-eg-table__row--alt"><td class="c-eg-table__cell c-eg-table__cell--key">Platform Name:</td><td class="c-eg-table__cell">@Model.PlatformName</td></tr>
                        <tr class="c-eg-table__row"><td class="c-eg-table__cell c-eg-table__cell--key">Platform Version:</td><td class="c-eg-table__cell">@Model.PlatformVersion</td></tr>
                        <tr class="c-eg-table__row c-eg-table__row--alt"><td class="c-eg-table__cell c-eg-table__cell--key">Browser Vendor:</td><td class="c-eg-table__cell">@Model.BrowserVendor</td></tr>
                        <tr class="c-eg-table__row"><td class="c-eg-table__cell c-eg-table__cell--key">Browser Name:</td><td class="c-eg-table__cell">@Model.BrowserName</td></tr>
                        <tr class="c-eg-table__row c-eg-table__row--alt"><td class="c-eg-table__cell c-eg-table__cell--key">Browser Version:</td><td class="c-eg-table__cell">@Model.BrowserVersion</td></tr>
                        <tr class="c-eg-table__row"><td class="c-eg-table__cell c-eg-table__cell--key">Screen width (pixels):</td><td class="c-eg-table__cell">@Model.ScreenWidth</td></tr>
                        <tr class="c-eg-table__row c-eg-table__row--alt"><td class="c-eg-table__cell c-eg-table__cell--key">Screen height (pixels):</td><td class="c-eg-table__cell">@Model.ScreenHeight</td></tr>
                        <tr class="c-eg-table__row"><td class="c-eg-table__cell c-eg-table__cell--key">Device Id:</td><td class="c-eg-table__cell">@Model.DeviceId</td></tr>
                    </tbody>
                </table>
            </div>

            <div>
                <h3 class="c-eg-page__heading">IP intelligence results</h3>

                @if (!string.IsNullOrEmpty(Model.IpMessage))
                {
                    <p class="c-eg-page__lead">@Model.IpMessage</p>
                }

                <table class="c-eg-table">
                    <thead class="c-eg-table__head">
                        <tr class="c-eg-table__row">
                            <th class="c-eg-table__cell">Property</th>
                            <th class="c-eg-table__cell">Value</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr class="c-eg-table__row c-eg-table__row--alt"><td class="c-eg-table__cell c-eg-table__cell--key">Registered Name:</td><td class="c-eg-table__cell" id="RegisteredName">@Model.RegisteredName</td></tr>
                        <tr class="c-eg-table__row"><td class="c-eg-table__cell c-eg-table__cell--key">Registered Owner:</td><td class="c-eg-table__cell">@Model.RegisteredOwner</td></tr>
                        <tr class="c-eg-table__row c-eg-table__row--alt"><td class="c-eg-table__cell c-eg-table__cell--key">Registered Country:</td><td class="c-eg-table__cell">@Model.RegisteredCountry</td></tr>
                        <tr class="c-eg-table__row"><td class="c-eg-table__cell c-eg-table__cell--key">IP Range Start:</td><td class="c-eg-table__cell" id="IpRangeStart">@Model.IpRangeStart</td></tr>
                        <tr class="c-eg-table__row c-eg-table__row--alt"><td class="c-eg-table__cell c-eg-table__cell--key">IP Range End:</td><td class="c-eg-table__cell">@Model.IpRangeEnd</td></tr>
                        <tr class="c-eg-table__row"><td class="c-eg-table__cell c-eg-table__cell--key">Country:</td><td class="c-eg-table__cell" id="Country">@Model.Country</td></tr>
                        <tr class="c-eg-table__row c-eg-table__row--alt"><td class="c-eg-table__cell c-eg-table__cell--key">Country Code:</td><td class="c-eg-table__cell">@Model.CountryCode</td></tr>
                        <tr class="c-eg-table__row"><td class="c-eg-table__cell c-eg-table__cell--key">Country Code 3:</td><td class="c-eg-table__cell">@Model.CountryCode3</td></tr>
                        <tr class="c-eg-table__row c-eg-table__row--alt"><td class="c-eg-table__cell c-eg-table__cell--key">Region:</td><td class="c-eg-table__cell">@Model.Region</td></tr>
                        <tr class="c-eg-table__row"><td class="c-eg-table__cell c-eg-table__cell--key">State:</td><td class="c-eg-table__cell">@Model.State</td></tr>
                        <tr class="c-eg-table__row c-eg-table__row--alt"><td class="c-eg-table__cell c-eg-table__cell--key">Town:</td><td class="c-eg-table__cell">@Model.Town</td></tr>
                        <tr class="c-eg-table__row"><td class="c-eg-table__cell c-eg-table__cell--key">Latitude:</td><td class="c-eg-table__cell">@Model.Latitude</td></tr>
                        <tr class="c-eg-table__row c-eg-table__row--alt"><td class="c-eg-table__cell c-eg-table__cell--key">Longitude:</td><td class="c-eg-table__cell">@Model.Longitude</td></tr>
                        <tr class="c-eg-table__row"><td class="c-eg-table__cell c-eg-table__cell--key">Areas:</td><td class="c-eg-table__cell">@Model.Areas</td></tr>
                        <tr class="c-eg-table__row c-eg-table__row--alt"><td class="c-eg-table__cell c-eg-table__cell--key">Accuracy Radius:</td><td class="c-eg-table__cell">@Model.AccuracyRadius</td></tr>
                        <tr class="c-eg-table__row"><td class="c-eg-table__cell c-eg-table__cell--key">Time Zone Offset:</td><td class="c-eg-table__cell">@Model.TimeZoneOffset</td></tr>
                        <tr class="c-eg-table__row c-eg-table__row--alt">
                            <td class="c-eg-table__cell c-eg-table__cell--key">Country Codes Geographical:</td>
                            <td class="c-eg-table__cell">
                                <ul>
                                    @foreach (var c in Model.CountryCodesGeographical)
                                    {
                                        <li>@c</li>
                                    }
                                </ul>
                            </td>
                        </tr>
                        <tr class="c-eg-table__row">
                            <td class="c-eg-table__cell c-eg-table__cell--key">Country Codes Population:</td>
                            <td class="c-eg-table__cell">
                                <ul>
                                    @foreach (var c in Model.CountryCodesPopulation)
                                    {
                                        <li>@c</li>
                                    }
                                </ul>
                            </td>
                        </tr>
                        <tr class="c-eg-table__row c-eg-table__row--alt">
                            <td class="c-eg-table__cell c-eg-table__cell--key">Country Names Geographical All Translated:</td>
                            <td class="c-eg-table__cell">
                                <select id="CountryNamesGeographicalAllTranslated"
                                        name="CountryNamesGeographicalAllTranslated"
                                        class="form-control">
                                    @for (int i = 0; i < Model.CountryNamesGeographicalAllTranslated.Count
                                        && i < Model.CountryCodesGeographicalAll.Count; i++)
                                    {
                                        <option value="@Model.CountryCodesGeographicalAll[i]">@Model.CountryNamesGeographicalAllTranslated[i]</option>
                                    }
                                </select>
                            </td>
                        </tr>
                        <tr class="c-eg-table__row">
                            <td class="c-eg-table__cell c-eg-table__cell--key">Country Names Population All Translated:</td>
                            <td class="c-eg-table__cell">
                                <select id="CountryNamesPopulationAllTranslated"
                                        name="CountryNamesPopulationAllTranslated"
                                        class="form-control">
                                    @for (int i = 0; i < Model.CountryNamesPopulationAllTranslated.Count
                                        && i < Model.CountryCodesPopulationAll.Count; i++)
                                    {
                                        <option value="@Model.CountryCodesPopulationAll[i]">@Model.CountryNamesPopulationAllTranslated[i]</option>
                                    }
                                </select>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div id="map-section" class="c-eg-map" style="display: none;">
            <h3 class="c-eg-map__title">Location Map</h3>
            <div id="map" class="c-eg-map__canvas"></div>
        </div>

        <details class="c-eg-details">
            <summary>Evidence used</summary>
            <p class="c-eg-page__lead">Evidence collected from the current request</p>
            <table class="c-eg-table">
                <thead class="c-eg-table__head">
                    <tr class="c-eg-table__row">
                        <th class="c-eg-table__cell">Key</th>
                        <th class="c-eg-table__cell">Value</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Evidence != null)
                    {
                        var index = 0;
                        @foreach (var entry in Model.Evidence)
                        {
                            <tr class="c-eg-table__row @(index % 2 == 0 ? "c-eg-table__row--alt" : "")">
                                <td class="c-eg-table__cell c-eg-table__cell--key">@entry.Key</td>
                                <td class="c-eg-table__cell">@(entry.Value.Length > 100 ? entry.Value.Substring(0, 100) + "..." : entry.Value)</td>
                            </tr>
                            index++;
                        }
                    }
                </tbody>
            </table>
        </details>
    </div>

    @if (Model.NeedsEnterprise)
    {
        <div class="c-eg-message" id="needs-enterprise">
            <p class="c-eg-message__text">Some of these properties need the Enterprise data files. <a href="https://51degrees.com/contact-us?utm_source=code&amp;utm_medium=example&amp;utm_campaign=51degrees-dotnet&amp;utm_content=examples-onpremise-mixed-gettingstarted-web-views-home-index.cshtml&amp;utm_term=enterprise-data-file">Contact us</a> for a copy.</p>
            <a class="b-btn c-eg-message__cta" href="https://51degrees.com/contact-us?utm_source=code&amp;utm_medium=example&amp;utm_campaign=51degrees-dotnet&amp;utm_content=examples-onpremise-mixed-gettingstarted-web-views-home-index.cshtml&amp;utm_term=enterprise-data-file">Contact us</a>
        </div>
    }

    @* Kept outside #content, which the client-side results are appended to,
        so this section stays at the end of the page. *@
    <div class="c-eg-section" id="find-out-more">
        <hr />
        <h3 class="c-eg-page__heading">Find out more</h3>
        <ul>
            <li><a href="https://51degrees.com/device-detection?utm_source=code&amp;utm_medium=example&amp;utm_campaign=51degrees-dotnet&amp;utm_content=examples-onpremise-mixed-gettingstarted-web-views-home-index.cshtml&amp;utm_term=find-out-more">Device detection</a></li>
            <li><a href="https://51degrees.com/ip-intelligence?utm_source=code&amp;utm_medium=example&amp;utm_campaign=51degrees-dotnet&amp;utm_content=examples-onpremise-mixed-gettingstarted-web-views-home-index.cshtml&amp;utm_term=find-out-more">IP intelligence</a></li>
            <li><a href="https://51degrees.com/pricing?utm_source=code&amp;utm_medium=example&amp;utm_campaign=51degrees-dotnet&amp;utm_content=examples-onpremise-mixed-gettingstarted-web-views-home-index.cshtml&amp;utm_term=find-out-more">Data files and prices</a></li>
            <li><a href="https://51degrees.com/contact-us?utm_source=code&amp;utm_medium=example&amp;utm_campaign=51degrees-dotnet&amp;utm_content=examples-onpremise-mixed-gettingstarted-web-views-home-index.cshtml&amp;utm_term=find-out-more">Talk to 51Degrees about using it</a></li>
        </ul>
        <p class="c-eg-page__lead">The source code for this demo and what it uses.</p>
        <ul>
            <li><a href="https://github.com/51Degrees/51degrees-dotnet/tree/main/examples/ip-intelligence">https://github.com/51Degrees/51degrees-dotnet/tree/main/examples/ip-intelligence</a></li>
            <li><a href="https://github.com/51Degrees/51degrees-dotnet/tree/main/device-detection">https://github.com/51Degrees/51degrees-dotnet/tree/main/device-detection</a></li>
            <li><a href="https://github.com/51Degrees/51degrees-dotnet/tree/main/ip-intelligence">https://github.com/51Degrees/51degrees-dotnet/tree/main/ip-intelligence</a></li>
            <li><a href="https://github.com/51Degrees/51degrees-cxx">https://github.com/51Degrees/51degrees-cxx</a></li>
            <li><a href="https://github.com/51Degrees/51degrees-dotnet/tree/main/pipeline">https://github.com/51Degrees/51degrees-dotnet/tree/main/pipeline</a></li>
        </ul>
    </div>
</div>

@* Client-side JavaScript for evidence gathering and device detection callbacks.
    This View Component is provided by the FiftyOne.Pipeline.Web package.
    It generates the necessary JavaScript for client-side evidence collection
    and handles callbacks for enhanced device detection. The shared examples.js
    helper subscribes to the 'complete' event and appends a results table into
    #content. *@
@await Component.InvokeAsync("FiftyOneJS")

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="https://unpkg.com/wellknown@0.5.0/wellknown.js"></script>
<script src="~/js/examples.min.js"></script>

<script>
    window.onload = function () {
        fodExamples.bindDeviceCallback({ targetId: "content" });
        // A free data file has no location, so there is nothing to map.
        fodExamples.initLocationMap({
            areasWkt: '@Html.Raw(Model.MapAreas.Replace("'", "\\'"))',
            latitude: '@Model.MapLatitude',
            longitude: '@Model.MapLongitude'
        });
    };
</script>
