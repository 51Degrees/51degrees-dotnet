{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  // For a sample configuration file demonstrating all available options, see 
  // https://github.com/51Degrees/51degrees-dotnet/blob/main/examples/device-detection/sample-configuration.json
  "PipelineOptions": {
    "Elements": [
      {
        // Device Detection element
        "BuilderName": "DeviceDetectionHashEngineBuilder",
        "BuildParameters": {
          // The free Lite data file, which the example downloads to the
          // cxx/data/device-detection directory when it is missing. Name the
          // Enterprise data file here for the hardware properties.
          "DataFile": "51Degrees-LiteV4.1.hash",
          "CreateTempDataCopy": false,
          "AutoUpdate": false,
          "PerformanceProfile": "MaxPerformance",
          "DataFileSystemWatcher": false,
          "DataUpdateOnStartUp": false,
          "DataUpdateLicenseKey": "!!ENTER_YOUR_LICENSE_KEY_HERE!!",
          // Properties for device detection
          "Properties": "DeviceId,JavascriptHardwareProfile,HardwareVendor,HardwareModel,HardwareName,IsMobile,JavascriptGetHighEntropyValues,Promise,Fetch,DeviceType,PlatformVendor,PlatformName,PlatformVersion,BrowserVendor,BrowserName,BrowserVersion,ScreenPixelsWidth,ScreenPixelsHeight,ScreenPixelsWidthJavascript,ScreenPixelsHeightJavascript"
        }
      },
      {
        // IP Intelligence element  
        "BuilderName": "IpiOnPremiseEngineBuilder",
        "BuildParameters": {
          // The free Lite data file, which the example downloads to the
          // cxx/data/ip-intelligence directory when it is missing. Name the
          // Enterprise data file here for the location properties.
          "DataFile": "51Degrees-LiteV41.ipi",
          "CreateTempDataCopy": false,
          "AutoUpdate": false,
          "PerformanceProfile": "LowMemory",
          "DataFileSystemWatcher": false,
          "DataUpdateOnStartUp": false,
          "DataUpdateVerifyMD5": false,
          "DataUpdateURL": "!!ENTER_YOUR_PROVIDER_URL_HERE!!",
          // Properties for IP intelligence
          "Properties": "RegisteredName,RegisteredOwner,RegisteredCountry,IpRangeStart,IpRangeEnd,Country,CountryCode,CountryCode3,Region,State,Town,Latitude,Longitude,Areas,AccuracyRadiusMin,TimeZoneOffset"
        }
      },
      {
        // Required to add Javascript and JSON end points for 51Degrees.core.js and 
        "BuilderName": "JsonBuilderElement"
      }
    ],
    // Disable client-side evidence to avoid JSON serialization issues with IPAddress
    "ClientSideEvidenceEnabled": false,
    "UseAsyncScript": false
  }
}
