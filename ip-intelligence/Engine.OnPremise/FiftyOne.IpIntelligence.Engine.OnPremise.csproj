<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <Platforms>x64;ARM64</Platforms>
    <EnableUnmanagedDebugging>true</EnableUnmanagedDebugging>
    <DocumentationFile>FiftyOne.IpIntelligence.Engine.OnPremise.xml</DocumentationFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    
    <!-- NuGet package properties -->
    <PackageId>FiftyOne.IpIntelligence.Engine.OnPremise</PackageId>
    <Title>51Degrees IP Intelligence On-Premise Engine for the Pipeline API</Title>
    <Description>IP Intelligence and IP geolocation for .NET and C#. Finds an IP address's likely location (country, region, town, and coordinates), connection type, and network, reading a data file on your server. Network details include the Autonomous System Number (ASN). This package is the on-premise engine for the 51Degrees Pipeline API. An alternative to MaxMind and IPinfo.</Description>
    <Authors>51Degrees Engineering</Authors>
    <PackageLicenseExpression>EUPL-1.2</PackageLicenseExpression>
    <PackageIconUrl>https://51degrees.com/Nuget-FiftyOne.IpIntelligence.Engine.OnPremise/Square%20Logo.png</PackageIconUrl>
    <Copyright>51Degrees Mobile Experts Limited</Copyright>
    <PackageTags>51degrees;ip-intelligence;ip-geolocation;geoip;ip-lookup;asn;ip-to-country;pipeline;pipeline-api;ip;ip-address;geolocation;engine;on-premise;onprem;local;offline;maxmind;ipinfo</PackageTags>
    <RepositoryUrl>https://github.com/51Degrees/51degrees-dotnet</RepositoryUrl>
    <PackageProjectUrl>https://51degrees.com/ip-intelligence?utm_source=nuget&amp;utm_medium=package&amp;utm_campaign=51degrees-dotnet&amp;utm_content=fiftyone.ipintelligence.engine.onpremise&amp;utm_term=packageprojecturl</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>51d-logo.png</PackageIcon>
    <NeutralLanguage>en</NeutralLanguage>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- GitHub CI -->
    <BuiltOnCI>false</BuiltOnCI>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <DebugType>full</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);FIFTYONE_DEGREES_LARGE_DATA_FILE_SUPPORT</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|ARM64'">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);FIFTYONE_DEGREES_LARGE_DATA_FILE_SUPPORT</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|ARM64'">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- The FxCop analyzers check the netstandard2.0 build. On net10.0 they
         also ask for overloads, such as string.IndexOf(char,
         StringComparison), that netstandard2.0 does not have. -->
    <PackageReference Include="Microsoft.CodeAnalysis.FxCopAnalyzers" Version="3.0.0" Condition="'$(TargetFramework)' == 'netstandard2.0'">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- 
    Debug or Release are the only two outputs from the CMake / PreBuild.ps1 
    scripts. The $Configuration parameter might contain a wider range of options
    which will always in the string Debug or Release. The following sets a new
    parameter called BuildType to Debug or Release based on the content of the
    $Configuration parameter. This is then used to choose the target compiled
    binary.
  -->
  <PropertyGroup Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(Configuration)', 'Debug'))">
    <DebugType>full</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <BuildType>Debug</BuildType>
  </PropertyGroup>
  <PropertyGroup Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(Configuration)', 'Release'))">
    <BuildType>Release</BuildType>
  </PropertyGroup>

  <!--
    The platform the native library is built for. A platform named on the
    command line or by a solution wins. A project built as AnyCPU, which is
    what a project referenced from another solution gets, builds the library
    for the machine it runs on, so the engine works from any solution in
    this repository.
  -->
  <PropertyGroup>
    <FiftyOneNativeArch Condition="'$(Platform)' != '' and '$(Platform)' != 'AnyCPU'">$(Platform)</FiftyOneNativeArch>
    <FiftyOneNativeArch Condition="'$(FiftyOneNativeArch)' == '' and '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">ARM64</FiftyOneNativeArch>
    <FiftyOneNativeArch Condition="'$(FiftyOneNativeArch)' == '' and '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'X86'">x86</FiftyOneNativeArch>
    <FiftyOneNativeArch Condition="'$(FiftyOneNativeArch)' == ''">x64</FiftyOneNativeArch>
    <!--
      The same architecture as a runtime identifier uses it, in lower case,
      so a package packed directly puts the library in a runtimes folder
      that NuGet and the .targets file read.
    -->
    <FiftyOneNativeRidArch>$(FiftyOneNativeArch.ToLowerInvariant())</FiftyOneNativeRidArch>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="build\**" />
    <EmbeddedResource Remove="build\**" />
    <None Remove="build\**" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Remove=".editorconfig" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(ProjectDir)\build\windows\$(FiftyOneNativeArch)\$(BuildType)\FiftyOne.IpIntelligence.Engine.OnPremise.Native.dll" Condition="$([MSBuild]::IsOsPlatform('Windows'))" Link="FiftyOne.IpIntelligence.Engine.OnPremise.Native.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="$(ProjectDir)\build\linux\$(FiftyOneNativeArch)\$(BuildType)\FiftyOne.IpIntelligence.Engine.OnPremise.Native.dll" Condition="$([MSBuild]::IsOsPlatform('Linux'))" Link="FiftyOne.IpIntelligence.Engine.OnPremise.Native.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="$(ProjectDir)\build\macos\$(FiftyOneNativeArch)\$(BuildType)\FiftyOne.IpIntelligence.Engine.OnPremise.Native.dll" Condition="$([MSBuild]::IsOsPlatform('OSX'))" Link="FiftyOne.IpIntelligence.Engine.OnPremise.Native.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\Images\51d-logo.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
    <None Include=".editorconfig" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\FiftyOne.IpIntelligence.Shared.csproj" />
  </ItemGroup>

  <!-- Package files to add to the NuGet package when packaging -->
  <ItemGroup>
    <!-- Package the .targets file which copies the DLLs in Framework projects -->
    <_PackageFiles Include="FiftyOne.IpIntelligence.Engine.OnPremise.targets">
      <BuildAction>None</BuildAction>
      <PackagePath>build</PackagePath>
    </_PackageFiles>

    <!-- GitHub CI -->
    <!-- Copy the Windows x64 native DLL -->
    <_PackageFiles Include="..\windows\x64\FiftyOne.IpIntelligence.Engine.OnPremise.Native.dll" Condition="$(BuiltOnCI)">
      <BuildAction>None</BuildAction>
      <PackagePath>runtimes\win-x64\native</PackagePath>
    </_PackageFiles>
    <!-- Copy the Linux x64 native DLL -->
    <_PackageFiles Include="..\linux\x64\FiftyOne.IpIntelligence.Engine.OnPremise.Native.dll" Condition="$(BuiltOnCI)">
      <BuildAction>None</BuildAction>
      <PackagePath>runtimes\linux-x64\native</PackagePath>
    </_PackageFiles>
    <!-- Copy the Linux arm64 native DLL -->
    <_PackageFiles Include="..\linux\arm64\FiftyOne.IpIntelligence.Engine.OnPremise.Native.dll" Condition="$(BuiltOnCI)">
      <BuildAction>None</BuildAction>
      <PackagePath>runtimes\linux-arm64\native</PackagePath>
    </_PackageFiles>
    <!-- Copy the Mac x64 native DLL -->
    <_PackageFiles Include="..\macos\x64\FiftyOne.IpIntelligence.Engine.OnPremise.Native.dll" Condition="$(BuiltOnCI)">
      <BuildAction>None</BuildAction>
      <PackagePath>runtimes\osx-x64\native</PackagePath>
    </_PackageFiles>
    <!-- Copy the Mac arm64 native DLL -->
    <_PackageFiles Include="..\macos\arm64\FiftyOne.IpIntelligence.Engine.OnPremise.Native.dll" Condition="$(BuiltOnCI)">
      <BuildAction>None</BuildAction>
      <PackagePath>runtimes\osx-arm64\native</PackagePath>
    </_PackageFiles>

    <!-- Direct pack, the native DLL built for FiftyOneNativeArch -->
    <!-- Copy the Windows native DLL -->
    <_PackageFiles Include="$(OutputPath)\FiftyOne.IpIntelligence.Engine.OnPremise.Native.dll" Condition="$([MSBuild]::IsOsPlatform('Windows')) AND !$(BuiltOnCI)">
      <BuildAction>None</BuildAction>
      <PackagePath>runtimes\win-$(FiftyOneNativeRidArch)\native</PackagePath>
    </_PackageFiles>
    <!-- Copy the Linux native DLL -->
    <_PackageFiles Include="$(OutputPath)\FiftyOne.IpIntelligence.Engine.OnPremise.Native.dll" Condition="$([MSBuild]::IsOsPlatform('Linux')) AND !$(BuiltOnCI)">
      <BuildAction>None</BuildAction>
      <PackagePath>runtimes\linux-$(FiftyOneNativeRidArch)\native</PackagePath>
    </_PackageFiles>
    <!-- Copy the Mac native DLL -->
    <_PackageFiles Include="$(OutputPath)\FiftyOne.IpIntelligence.Engine.OnPremise.Native.dll" Condition="$([MSBuild]::IsOsPlatform('OSX')) AND !$(BuiltOnCI)">
      <BuildAction>None</BuildAction>
      <PackagePath>runtimes\osx-$(FiftyOneNativeRidArch)\native</PackagePath>
    </_PackageFiles>
  </ItemGroup>

  <!--
    The native library is the same for every target framework. Each target
    framework's build asks one instance of this project, without a target
    framework, to build it, and MSBuild runs a target once per instance, so
    CMake runs once rather than once per target framework at the same time
    in the same folder. FiftyOneNativeOnly keeps that instance apart from
    the build that dispatches the target frameworks.
  -->
  <Target Name="PreBuild" BeforeTargets="PreBuildEvent">
    <MSBuild Projects="$(MSBuildProjectFullPath)"
             Targets="FiftyOneBuildNative"
             Properties="FiftyOneNativeOnly=true"
             RemoveProperties="TargetFramework;RuntimeIdentifier" />
  </Target>
  <Target Name="FiftyOneBuildNative">
    <Exec Command="pwsh $(MSBuildThisFileDirectory)PreBuild.ps1 -BuildType $(BuildType) -Arch $(FiftyOneNativeArch)" />
  </Target>

</Project>
