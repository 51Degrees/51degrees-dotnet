<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Platforms>AnyCPU;x64</Platforms>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DocumentationFile>FiftyOne.IpIntelligence.Cloud.xml</DocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Authors>51Degrees Engineering</Authors>
    <Copyright>51Degrees Mobile Experts Limited</Copyright>
    <PackageLicenseExpression>EUPL-1.2</PackageLicenseExpression>
    <PackageProjectUrl>https://51degrees.com?utm_source=nuget&amp;utm_medium=package&amp;utm_campaign=51degrees-dotnet&amp;utm_content=fiftyone.ipintelligence.cloud-fiftyone.ipintelligence.cloud.csproj&amp;utm_term=packageprojecturl</PackageProjectUrl>
    <PackageIcon>51d-logo.png</PackageIcon>
    <RepositoryUrl>https://github.com/51Degrees/51degrees-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>51degrees;ip-intelligence;ip-geolocation;geoip;ip-lookup;asn;ip-to-country;pipeline;pipeline-api;ip;ip-address;geolocation;cloud;hosted;saas;api</PackageTags>
	<Title>51Degrees IP Intelligence Cloud Service for the Pipeline API</Title>
    <Description>IP Intelligence and IP geolocation for .NET and C#. Finds an IP address's likely location (country, region, town, and coordinates), connection type, and network, using the 51Degrees cloud service with a Resource Key. Network details include the Autonomous System Number (ASN). This package is the cloud engine for the 51Degrees Pipeline API, for IP Intelligence without running an on-premise engine.</Description>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <DebugType>full</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <FiftyOneReference Include="FiftyOne.Pipeline.CloudRequestEngine" ProjectPath="..\..\pipeline\CloudRequestEngine\FiftyOne.Pipeline.CloudRequestEngine.csproj" Version="$(FiftyOnePipelineVersion)" />
    <PackageReference Include="Microsoft.CodeAnalysis.FxCopAnalyzers" Version="3.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\FiftyOne.IpIntelligence.Shared.csproj" />
    <ProjectReference Include="..\Translation\FiftyOne.IpIntelligence.Translation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Images\51d-logo.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>
	
</Project>
