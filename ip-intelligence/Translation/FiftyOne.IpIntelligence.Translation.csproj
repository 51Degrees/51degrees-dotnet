<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <Platforms>AnyCPU;x64;ARM64</Platforms>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DocumentationFile>FiftyOne.IpIntelligence.Translation.xml</DocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors />
    <!-- NuGet package properties -->
    <PackageId>FiftyOne.IpIntelligence.Translation</PackageId>
    <Title>51Degrees IP Intelligence Country Translation Engines</Title>
    <Description>Translation engines which take country code lists provided by FiftyOne.IpIntelligence and translate into country names in the requested language.</Description>
    <Authors>51Degrees Engineering</Authors>
    <PackageLicenseExpression>EUPL-1.2</PackageLicenseExpression>
    <PackageIconUrl>https://51degrees.com/Nuget-FiftyOne.IpIntelligence/Square%20Logo.png</PackageIconUrl>
    <Copyright>51Degrees Mobile Experts Limited</Copyright>
    <PackageTags>51degrees;pipeline;pipeline-api;ip-intelligence;language;translation</PackageTags>
    <RepositoryUrl>https://github.com/51Degrees/51degrees-dotnet</RepositoryUrl>
    <PackageProjectUrl>https://51degrees.com/ip-intelligence?utm_source=nuget&amp;utm_medium=package&amp;utm_campaign=51degrees-dotnet&amp;utm_content=fiftyone.ipintelligence.translation&amp;utm_term=packageprojecturl</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>51d-logo.png</PackageIcon>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <DebugType>full</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\Images\51d-logo.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\Shared\FiftyOne.IpIntelligence.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\cxx\data\ip-intelligence\Translations\OSM\countries.*.yml" LinkBase="Resources\" WithCulture="false" />
    <EmbeddedResource Include="..\..\cxx\data\ip-intelligence\Translations\countrycodes.*.yml" LinkBase="Resources\" WithCulture="false" />
  </ItemGroup>

  <ItemGroup>
    <FiftyOneReference Include="FiftyOne.Pipeline.Translation" ProjectPath="..\..\pipeline\Translation\FiftyOne.Pipeline.Translation.csproj" Version="$(FiftyOnePipelineVersion)" />
  </ItemGroup>

</Project>
